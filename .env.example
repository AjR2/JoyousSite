# ===========================================
# Web Automation - Environment Variables
# ===========================================
# Copy this file to .env and fill in your credentials
# NEVER commit .env with real credentials!

# ===========================================
# AI APIs (ALREADY CONFIGURED - reuse these!)
# ===========================================
# These are used by Nimbus AI and the automation system
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
XAI_GROK_API_KEY=your_grok_api_key

# Email Recipients (comma-separated)
AUTOMATION_RECIPIENTS=your-email@example.com

# ===========================================
# INSTAGRAM (via Facebook Graph API)
# ===========================================
# Get these from: https://developers.facebook.com/
# 1. Create a Facebook App
# 2. Add Instagram Graph API product
# 3. Connect your Instagram Business/Creator account
# 4. Generate a long-lived access token
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# ===========================================
# TWITTER / X
# ===========================================
# Get these from: https://developer.twitter.com/
# 1. Create a Twitter Developer account
# 2. Create a Project and App
# 3. Generate Bearer Token (for read-only access)
# 4. Get your User ID from: https://tweeterid.com/
TWITTER_BEARER_TOKEN=
TWITTER_USER_ID=

# ===========================================
# LINKEDIN
# ===========================================
# Get these from: https://www.linkedin.com/developers/
# 1. Create a LinkedIn App
# 2. Request Marketing Developer Platform access (for analytics)
# 3. Generate OAuth access token with r_organization_social scope
# 4. Get Organization ID from your company page URL
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_ID=

# ===========================================
# FACEBOOK
# ===========================================
# Get these from: https://developers.facebook.com/
# 1. Create a Facebook App (same as Instagram or separate)
# 2. Add Facebook Login product
# 3. Generate Page Access Token with read_insights permission
# 4. Get Page ID from your Facebook Page's About section
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# ===========================================
# EMAIL DELIVERY - Mailgun (Recommended)
# ===========================================
# Get these from: https://mailgun.com/
# 1. Create a Mailgun account (free tier: 5,000 emails/month for 3 months, then 1,000/month)
# 2. Add and verify your sending domain
# 3. Get API key from Settings → API Keys
# 4. Use your verified domain (e.g., mg.yourdomain.com)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=Analytics Reporter <analytics@yourdomain.com>

# ===========================================
# EMAIL DELIVERY - SendGrid (Alternative)
# ===========================================
# Get these from: https://sendgrid.com/
# 1. Create a SendGrid account (free tier: 100 emails/day)
# 2. Create an API Key with Mail Send permission
# 3. Verify your sender email address
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=analytics@yourdomain.com

# ===========================================
# EMAIL DELIVERY - SMTP (Alternative)
# ===========================================
# Use if you prefer SMTP over Mailgun/SendGrid
# Works with Gmail, Outlook, or any SMTP server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
# Where contact form submissions are delivered
CONTACT_TO_EMAIL=your-email@gmail.com

# ===========================================
# GENERAL SETTINGS
# ===========================================
EMAIL_SERVICE=mailgun
# Options: 'console' (testing), 'mailgun', 'sendgrid', 'nodemailer'

# ===========================================
# YOUTUBE (Analytics Reporter)
# ===========================================
# Get these from: https://console.cloud.google.com/
# 1. Create a Google Cloud project
# 2. Enable YouTube Data API v3
# 3. Create API credentials (API Key)
# 4. Find your channel ID from: youtube.com/account_advanced
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
# Optional: OAuth refresh token for full analytics (advanced)
YOUTUBE_OAUTH_REFRESH_TOKEN=

# ===========================================
# ANALYTICS REPORTER CONFIGURATION
# ===========================================
# Enable/disable the analytics reporter
ANALYTICS_ENABLED=false
# Primary recipient for daily analytics reports
ANALYTICS_PRIMARY_RECIPIENT=
# Secondary recipient (optional)
ANALYTICS_SECONDARY_RECIPIENT=
# Comma-separated list of enabled platforms (youtube, twitter_x, instagram, tiktok)
ANALYTICS_ENABLED_PLATFORMS=youtube
# Report window in days (default: 7)
ANALYTICS_REPORT_WINDOW_DAYS=7
# Email subject prefix (optional)
ANALYTICS_EMAIL_SUBJECT_PREFIX=
# Enable scheduled sending (true/false)
ANALYTICS_SCHEDULED_SENDING=false
# Cron expression for scheduled reports (default: daily at 9 AM)
ANALYTICS_CRON_EXPRESSION=0 9 * * *
# Timezone for scheduled reports
ANALYTICS_TIMEZONE=America/New_York
# Include CSV attachments (true/false)
ANALYTICS_INCLUDE_CSV=false

# ===========================================
# ADMIN AUTHENTICATION
# ===========================================
# Admin panel login credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-secure-password

